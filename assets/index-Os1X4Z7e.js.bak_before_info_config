const numberToWordsVN_v3 = (num) => {
  if (!num || isNaN(num) || num <= 0) return "Không đồng";
  const units = ["", "một", "hai", "ba", "bốn", "năm", "sáu", "bảy", "tám", "chín"];
  const teens = ["mười", "mười một", "mười hai", "mười ba", "mười bốn", "mười lăm", "mười sáu", "mười bảy", "mười tám", "mười chín"];
  function readGroup(n) {
    let tr = Math.floor(n / 100);
    let ch = Math.floor((n % 100) / 10);
    let dv = n % 10;
    let s = "";
    if (tr > 0) s += units[tr] + " trăm ";
    if (ch === 0 && dv > 0 && tr > 0) s += "lẻ ";
    else if (ch === 1) s += teens[dv] + " ";
    else if (ch > 1) {
      s += units[ch] + " mươi ";
      if (dv === 1) s += "mốt ";
      else if (dv === 5) s += "lăm ";
      else if (dv > 0) s += units[dv] + " ";
    } else if (dv > 0) s += units[dv] + " ";
    return s.trim();
  }
  let s = "";
  let b = Math.floor(num / 1000000000);
  let tr = Math.floor((num % 1000000000) / 1000000);
  let ng = Math.floor((num % 1000000) / 1000);
  let d = Math.floor(num % 1000);
  if (b > 0) s += readGroup(b) + " tỷ ";
  if (tr > 0) s += readGroup(tr) + " triệu ";
  if (ng > 0) s += readGroup(ng) + " ngàn ";
  if (d > 0) s += readGroup(d) + " ";
  s = s.trim() + " đồng";
  return s.charAt(0).toUpperCase() + s.slice(1);
};

