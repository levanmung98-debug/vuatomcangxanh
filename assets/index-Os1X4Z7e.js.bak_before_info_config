// Extend me storage
me.getSales = function() {
  try {
    return JSON.parse(localStorage.getItem(Ot.SALES) || "[]");
  } catch(e) {
    return [];
  }
};

me.saveSales = function(list) {
  try {
    localStorage.setItem(Ot.SALES, JSON.stringify(list));
  } catch(e) {
    console.warn("Save sales error", e);
  }
};

me.updateSale = function(id, updates) {
  const list = me.getSales();
  const index = list.findIndex(s => s.id === id);
  if (index !== -1) {
    list[index] = { ...list[index], ...updates };
    me.saveSales(list);
    return list[index];
  }
  return null;
};
me.addSale = function(sale) {
  const list = me.getSales();
  list.unshift(sale);
  me.saveSales(list);
  return sale;
};

me.deleteSale = function(id) {
  const list = me.getSales().filter(s => s.id !== id);
  me.saveSales(list);
};

