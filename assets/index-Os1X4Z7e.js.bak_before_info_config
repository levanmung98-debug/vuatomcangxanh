me.addBuyer = function(buyer) {
  const list = me.getBuyers();
  const phone = (buyer.phone || "").trim();
  const name = (buyer.name || "").trim();
  const id = buyer.id;
  
  let idx = -1;
  if (id) {
    idx = list.findIndex(b => b.id === id);
  }
  if (idx < 0) {
    idx = list.findIndex(b => (phone && b.phone === phone) || (name && b.name.toLowerCase() === name.toLowerCase()));
  }
  
  if (idx >= 0) {
    list[idx] = { ...list[idx], ...buyer, updatedAt: new Date().toISOString() };
  } else {
    list.unshift({
      id: "b_" + Date.now().toString(),
      targetGroup: buyer.targetGroup || "FACTORY",
      name,
      representative: buyer.representative || "",
      phone,
      address: buyer.address || "",
      latitude: buyer.latitude || null,
      longitude: buyer.longitude || null,
      shrimpPrices: buyer.shrimpPrices || [],
      defaultVehiclePlate: buyer.defaultVehiclePlate || "",
      defaultDriverPhone: buyer.defaultDriverPhone || "",
      defaultDriverName: buyer.defaultDriverName || "",
      marketDeliveryTime: buyer.marketDeliveryTime || "",
      note: buyer.note || "",
      debtAmount: buyer.debtAmount || 0,
      createdAt: new Date().toISOString()
    });
  }
  me.saveBuyers(list);
};

me.deleteBuyer = function(id) {
  const list = me.getBuyers().filter(b => b.id !== id);
  me.saveBuyers(list);
};

